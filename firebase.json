{
  "hosting": [
    {
      "target": "hilmost-toolbox",
      "public": "apps/hilmost_toolbox_web/out",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|webp|png|jpg|svg|woff2|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            },
            {
              "key": "CDN-Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "X-Robots-Tag",
              "value": "index, follow"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Link",
              "value": "</.well-known/agent-skills/index.json>; rel=\"agent-skills\", </llms.txt>; rel=\"describedby\", </sitemap.xml>; rel=\"sitemap\""
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/knowledge-base/understanding-compound-interest",
          "destination": "/guides/compound-interest-explained",
          "type": 301
        },
        {
          "source": "/knowledge-base/what-is-body-mass-index",
          "destination": "/guides/bmi-calculator-score-meaning",
          "type": 301
        },
        {
          "source": "/knowledge-base/unix-epoch-time-explained",
          "destination": "/guides/understanding-unix-timestamps",
          "type": 301
        },
        {
          "source": "/knowledge-base/universal-law-of-gravitation",
          "destination": "/calculators/astrophysics/gravitational-force",
          "type": 301
        },
        {
          "source": "/knowledge-base/cryptographic-hashing-md5",
